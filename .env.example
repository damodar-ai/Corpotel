# Backend Configuration
PORT=5000
NODE_ENV=development
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_SECRET_KEY

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=YOUR_DATABASE_PASSWORD
DB_NAME=corp_hotel_booking
DB_PORT=3306

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Google OAuth Configuration
# Get these credentials from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3000/login

# Admin Configuration
# Comma-separated list of email addresses that should have admin role
ADMIN_EMAILS=admin@yourdomain.com

# Vite Frontend Configuration (in frontend/.env)
VITE_API_URL=http://localhost:5000/api
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID

