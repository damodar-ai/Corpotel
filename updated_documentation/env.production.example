# Production Environment Variables Template
# Copy to backend/.env for production deployment

# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://corphotel.com

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=your-production-db-host.rds.amazonaws.com
DB_PORT=3306
DB_USER=corphotel_prod
DB_PASSWORD=your_secure_production_password
DB_NAME=corp_hotel_booking

# ============================================
# JWT AUTHENTICATION
# ============================================
# Generate with: openssl rand -base64 64
JWT_SECRET=your_64_character_production_secret_here_generated_with_openssl

# ============================================
# GOOGLE OAUTH 2.0 (Production)
# ============================================
# Use production credentials from Google Cloud Console
GOOGLE_CLIENT_ID=your_production_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_production_client_secret
GOOGLE_REDIRECT_URI=https://api.corphotel.com/api/auth/google/callback

# ============================================
# ADMIN CONFIGURATION
# ============================================
ADMIN_EMAILS=admin@corphotel.com

# ============================================
# MONITORING (Optional)
# ============================================
# SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
# LOG_LEVEL=warn
